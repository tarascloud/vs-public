generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role              UserRole  @default(CLIENT)
  locale            String    @default("en")
  telegramUsername  String?
  telegramId        String?
  telegramChatId    String?
  invitedBy         String?
  invitedAt         DateTime?
  accounts      Account[]
  sessions      Session[]
  projects      ProjectAccess[]
  questions     Question[]
  taskFeedbacks TaskFeedback[]
  initiatives   Initiative[]
  initiativeMessages InitiativeMessage[]
  linkTokens    TelegramLinkToken[]
  assignedTasks Task[]    @relation("assignedTasks")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TelegramLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum UserRole {
  OWNER
  CLIENT
  VIEWER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// Agents
model Agent {
  id           String   @id @default(cuid())
  name         String   @unique
  displayName  String
  description  String
  role         String
  instructions String   @db.Text
  tools        String[]
  model        String   @default("sonnet")
  isActive     Boolean  @default(true)
  avatarUrl    String?
  avatarEmoji  String?
  color        String?
  bio          String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tasks        Task[]
  history      AgentHistory[]
  activities   AgentActivity[]
}

model AgentHistory {
  id        String   @id @default(cuid())
  agentId   String
  field     String
  oldValue  String?  @db.Text
  newValue  String   @db.Text
  changedBy String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([agentId])
}

model AgentActivity {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  action    String   // TASK_STARTED, TASK_COMPLETED, TASK_BLOCKED, ERROR, DEPLOYED, MESSAGE
  details   String?  @db.Text
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([taskId])
  @@index([createdAt])
}

// Projects
model Project {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  techStack   String[]
  url              String?
  ga4MeasurementId String?
  status      ProjectStatus   @default(ACTIVE)
  access      ProjectAccess[]
  tasks       Task[]
  updates     ProjectUpdate[]
  initiatives Initiative[]
  smmAccounts SmmAccount[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model ProjectAccess {
  id        String            @id @default(cuid())
  userId    String
  projectId String
  role      ProjectAccessRole @default(VIEWER)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([userId, projectId])
}

enum ProjectAccessRole {
  OWNER
  CLIENT
  VIEWER
}

model ProjectUpdate {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String     @db.Text
  type        UpdateType @default(FEATURE)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([projectId])
}

enum UpdateType {
  FEATURE
  FIX
  RELEASE
  MILESTONE
}

enum AssigneeType {
  AGENT
  OWNER
  CLIENT
}

// Tasks (Kanban)
model Task {
  id          String     @id @default(cuid())
  ticketId    String     @unique
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  type        TaskType   @default(FEATURE)
  priority    Int        @default(0)
  agentId      String?
  projectId    String?
  initiativeId String
  assigneeType   AssigneeType @default(AGENT)
  assigneeUserId String?
  agent        Agent?      @relation(fields: [agentId], references: [id])
  project      Project?    @relation(fields: [projectId], references: [id])
  // DEV-20260601: onDelete:Cascade added so deleting an Initiative
  // cleanly removes all its Tasks. Task children (Question, TaskQuestion,
  // TaskFeedback, AgentActivity) already have onDelete:Cascade on Task,
  // so the cascade chains naturally.
  initiative   Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  assigneeUser User?       @relation("assignedTasks", fields: [assigneeUserId], references: [id])
  blockedBy    Task[]      @relation("TaskDependencies")
  blocking     Task[]      @relation("TaskDependencies")
  questions    Question[]
  taskQuestions TaskQuestion[]
  feedbacks    TaskFeedback[]
  completionNote String?    @db.Text
  commitHash     String?
  commitUrl      String?
  tokensUsed     Int?
  completedAt    DateTime?
  // MP-PROCESS-20260411-01: machine-verifiable acceptance criteria
  acceptanceCriteria  String?             @db.Text
  verificationCommand String?             @db.Text
  verificationOutput  String?             @db.Text
  verifiedAt          DateTime?
  verificationStatus  VerificationStatus?
  sprintDate  DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  AgentActivity[]

  @@index([status])
  @@index([agentId])
  @@index([projectId])
  @@index([initiativeId])
  @@index([assigneeUserId])
  @@index([initiativeId, status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  TESTING
  DONE
}

enum TaskType {
  FEATURE
  BUG
  CHORE
  REVIEW
}

// MP-PROCESS-20260411-01: task verification outcome
enum VerificationStatus {
  PASS
  FAIL
  SKIPPED      // legacy tasks without acceptance criteria
  NO_RUNTIME   // docs / decision tasks that cannot be runtime-verified
  NO_GIT       // changes live on disk outside of git (scripts, config)
}

model Question {
  id        String         @id @default(cuid())
  taskId    String
  text      String         @db.Text
  answer    String?        @db.Text
  status    QuestionStatus @default(PENDING)
  askedById String?
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  askedBy   User?          @relation(fields: [askedById], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([taskId])
  @@index([askedById])
}

enum QuestionStatus {
  PENDING
  ANSWERED
}

// Initiatives
model Initiative {
  id            String           @id @default(cuid())
  title         String?
  rawIdea       String           @db.Text
  summary       String?          @db.Text
  status        InitiativeStatus @default(IDEA)
  priority      Int              @default(0)
  userId        String
  projectId     String
  smmAccountId  String?
  callbackUrl   String?          @db.Text
  user          User             @relation(fields: [userId], references: [id])
  project       Project          @relation(fields: [projectId], references: [id])
  smmAccount    SmmAccount?      @relation(fields: [smmAccountId], references: [id])
  tasks         Task[]
  messages      InitiativeMessage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([smmAccountId])
}

// SMM Accounts
model SmmAccount {
  id          String      @id @default(cuid())
  platform    String      // youtube, twitter, instagram, tiktok, linkedin
  accountName String
  accountUrl  String
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])
  secrets     Json?       // metadata: key names stored in Infisical (NOT values)
  avatarUrl   String?
  description String?
  analytics   Json?       // cached analytics data
  initiatives Initiative[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([platform])
  @@index([projectId])
}

enum InitiativeStatus {
  IDEA
  PLANNING
  PLANNED
  IN_PROGRESS
  BLOCKED
  DONE
}

model InitiativeMessage {
  id            String      @id @default(cuid())
  initiativeId  String
  type          String      @default("info")
  content       String      @db.Text
  fromAgent     String?
  fromUserId    String?
  initiative    Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  fromUser      User?       @relation(fields: [fromUserId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([initiativeId])
  @@index([fromUserId])
}

// Client-facing task questions and feedback
model TaskQuestion {
  id          String         @id @default(cuid())
  taskId      String
  question    String         @db.Text
  answer      String?        @db.Text
  status      QuestionStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  answeredAt  DateTime?
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskFeedback {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  comment   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

// Waitlist
model OfficeLayout {
  id        String   @id @default("default")
  name      String
  data      Json     // stores { floor: number[][], walls: number[][], furniture: FurniturePlacement[] }
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  message   String?  @db.Text
  createdAt DateTime @default(now())
}

model Email {
  id        String   @id @default(cuid())
  fromEmail String
  toEmail   String
  subject   String
  body      String   @db.Text
  bodyText  String?  @db.Text
  bodyHtml  String?  @db.Text
  messageId String?
  category  String   @default("other")
  read      Boolean  @default(false)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([messageId]) // REV-20260512-075: prevent duplicate ingest on redelivery
  @@index([createdAt])
  @@index([category])
  @@index([read])
  @@index([deleted, read])
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

model TelegramMessage {
  id        String           @id @default(cuid())
  chatId    String
  userId    String?
  username  String?
  firstName String?
  direction MessageDirection
  text      String           @db.Text
  messageId Int?
  createdAt DateTime         @default(now())

  @@unique([chatId, messageId])
  @@index([chatId, createdAt])
  @@index([createdAt])
}
