# ─── Database ────────────────────────────────────────────────────────────────
# PG_* are consumed by docker-compose.yml when it creates the postgres container.
PG_USER=vs
PG_PASSWORD=change-me
PG_DATABASE=vs

# Used by Prisma. Host differs by where the app runs:
#   npm run dev on your machine        → localhost:5432
#   the studio container in compose    → pg:5432   (service name on the compose network)
DATABASE_URL=postgresql://vs:change-me@localhost:5432/vs

# ─── Redis (rate limiting, task queues) ──────────────────────────────────────
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
INTERNAL_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# Shared secret for agent → API calls (header: x-internal-secret)
# openssl rand -hex 32
INTERNAL_API_SECRET=

# Second secret guarding the two seed endpoints (header: x-seed-secret).
# /api/agents/seed and /api/projects/seed require BOTH an OWNER session AND
# this header — if it is unset, those endpoints always answer 403.
# openssl rand -hex 32
SEED_SECRET=

# Where the agent markdown prompts live. Only needed when the repo layout
# differs from the default (the app resolves ../agents relative to app/).
# In the compose setup this is set to /agents by docker-compose.yml.
AGENTS_DIR=

# Email of the owner account. Used by internal workflow routes to resolve the
# owner's user id. It does NOT grant the OWNER role — see docs/QUICKSTART.md step 5.
OWNER_EMAIL=you@example.com

# ─── OAuth providers (at least one required to sign in) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# ─── Telegram bot (optional) ─────────────────────────────────────────────────
# Create via @BotFather. TG_CHAT_OWNER is your own numeric chat id.
TG_BOT_TOKEN=
TG_BOT_USERNAME=
TG_CHAT_OWNER=
TELEGRAM_WEBHOOK_SECRET=

# ─── MemPalace (optional, --profile memory) ──────────────────────────────────
# Read by the Studio to proxy /api/mempalace/*
MEMPALACE_URL=http://localhost:8031
MEMPALACE_WEBHOOK_URL=http://localhost:8031/ingest/convo
# One bearer token guards the whole HTTP sidecar — /ingest/* and /search alike.
# MEMPALACE_BEARER_TOKEN is only a legacy fallback name for the same value.
# openssl rand -hex 32
MEMPALACE_INGEST_TOKEN=
MEMPALACE_BEARER_TOKEN=

# Embedding backend (768-dim vectors). Defaults shown; the compose file starts
# an `ollama` service under the `memory` profile.
OLLAMA_EMBED_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Read by the MemPalace container itself. Either the full SQLAlchemy URL…
MEMPALACE_DB_URL=postgresql+psycopg://vs:change-me@pg:5432/mempalace
# …or the individual parts (defaults: pg / mempalace / mempalace / mempalace)
# MEMPALACE_DB_HOST=pg
# MEMPALACE_DB_NAME=mempalace
# MEMPALACE_DB_USER=mempalace
# MEMPALACE_DB_PASSWORD=

# ─── Optional integrations ───────────────────────────────────────────────────
# Transactional email (https://resend.com)
RESEND_API_KEY=
# Google Analytics Data API — path to a service-account JSON file
GOOGLE_ANALYTICS_CREDENTIALS=
# Self-hosted service monitoring dashboard, see infra/
STATUS_URL=
# Speech-to-text endpoint used by the voice agent
STT_URL=
