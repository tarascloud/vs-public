[Unit]
Description=Sync Infisical-rendered .env files to mempalace scrub-secrets
Documentation=https://github.com/tarascloud/vs-public/blob/main/infra/systemd/scrub-secrets-sync.service
After=network.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/docker/scripts/scrub-secrets-sync.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scrub-secrets-sync

# Safety: timeout if something hangs
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
