[Unit]
Description=Watch /opt/docker/secrets for .env file changes
Documentation=https://github.com/tarascloud/vs-public/blob/main/infra/systemd/scrub-secrets-sync.path

[Path]
# Trigger on close-after-write (inotify IN_CLOSE_WRITE)
PathChanged=/opt/docker/secrets

[Install]
WantedBy=multi-user.target
