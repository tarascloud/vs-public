{
  "name": "@vibe-studio/ui",
  "version": "0.1.0",
  "description": "Canonical shadcn/ui component library for Owner Cloud projects (PD, JF, SH, KO). Deduplicates per-project shadcn installs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button.tsx",
      "default": "./src/button.tsx"
    },
    "./input": {
      "types": "./src/input.tsx",
      "default": "./src/input.tsx"
    },
    "./card": {
      "types": "./src/card.tsx",
      "default": "./src/card.tsx"
    },
    "./dialog": {
      "types": "./src/dialog.tsx",
      "default": "./src/dialog.tsx"
    },
    "./select": {
      "types": "./src/select.tsx",
      "default": "./src/select.tsx"
    },
    "./locale-switcher": {
      "types": "./src/locale-switcher.tsx",
      "default": "./src/locale-switcher.tsx"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "@base-ui/react": ">=1.3.0",
    "class-variance-authority": ">=0.7.0",
    "lucide-react": ">=1.0.0",
    "clsx": ">=2.0.0",
    "tailwind-merge": ">=2.0.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tarascloud/vs-public",
    "directory": "packages/ui"
  }
}
